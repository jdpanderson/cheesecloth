# Maintainer: Jonathan Anderson <janderson@vectorface.com>
# Release package, built by CI from an archive of the tagged checkout:
#   git archive --prefix=cheesecloth-$pkgver/ -o arch/release/cheesecloth-$pkgver.tar.gz HEAD
# after setting pkgver (see dist/version.sh). For building from the
# repository directly, use ../PKGBUILD (cheesecloth-git).
pkgname=cheesecloth
pkgver=0.0.0
pkgrel=1
pkgdesc="WireGuard mesh network with identity-based membership"
arch=('x86_64' 'aarch64')
url="https://github.com/jdpanderson/cheesecloth"
license=('GPL-3.0-or-later')
makedepends=('go>=1.26')
optdepends=('wireguard-tools: inspect the interface with wg')
backup=('etc/cheesecloth/config.yaml')
install=cheesecloth.install
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP') # the archive is made from the same checkout as this file

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  export GOFLAGS="-buildmode=pie -trimpath -mod=mod -buildvcs=false"
  go build -ldflags "-X main.version=$pkgver -buildid=" -o cheesecloth ./cmd/cheesecloth
  # sed succeeds whether or not it substituted anything, so the unit is checked:
  # a changed ExecStart would otherwise name a path this package does not install
  sed 's|/usr/local/sbin/cheesecloth|/usr/bin/cheesecloth|' dist/cheesecloth.service > cheesecloth.service
  grep -qx 'ExecStart=/usr/bin/cheesecloth' cheesecloth.service
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 cheesecloth "$pkgdir/usr/bin/cheesecloth"
  install -Dm644 cheesecloth.service "$pkgdir/usr/lib/systemd/system/cheesecloth.service"
  install -Dm644 dist/config.yaml "$pkgdir/etc/cheesecloth/config.yaml"
  install -Dm644 README.md docs/configuration.md docs/operations.md docs/membership.md -t "$pkgdir/usr/share/doc/cheesecloth"
}
